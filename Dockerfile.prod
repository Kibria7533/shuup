# Production image for the Shuup workbench (gunicorn, non-root, no editable install).
# Build:  docker build -f Dockerfile.prod -t shuup-prod .

FROM node:12.21.0-buster-slim AS build

RUN sed -i \
        -e 's|deb.debian.org/debian|archive.debian.org/debian|g' \
        -e 's|security.debian.org|archive.debian.org|g' \
        -e '/buster-updates/d' \
        /etc/apt/sources.list \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid-until

RUN apt-get update \
    && apt-get --assume-yes install \
        gettext \
        libcairo2-dev \
        libffi-dev \
        libpangocairo-1.0-0 \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
    && rm -rf /var/lib/apt/lists/ /var/cache/apt/

WORKDIR /app
COPY . /app

RUN pip3 install --upgrade pip setuptools wheel \
    && python3 setup.py egg_info \
    && pip3 install markupsafe==1.1.1 jinja2==2.8.1 \
    && pip3 install -r shuup.egg-info/requires.txt gunicorn==20.1.0 whitenoise==5.3.0 \
    && pip3 install psycopg2-binary==2.9.9 \
    && pip3 install --no-deps --no-build-isolation . \
    && rm -rf /app/build /app/dist /app/*.egg-info

ENV DJANGO_DEBUG=0 DJANGO_SERVE_STATIC=1
RUN python3 -m shuup_workbench collectstatic --noinput


FROM node:12.21.0-buster-slim

RUN sed -i \
        -e 's|deb.debian.org/debian|archive.debian.org/debian|g' \
        -e 's|security.debian.org|archive.debian.org|g' \
        -e '/buster-updates/d' \
        /etc/apt/sources.list \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid-until

RUN apt-get update \
    && apt-get --assume-yes install \
        libcairo2 \
        libpango-1.0-0 \
        libpangocairo-1.0-0 \
        python3 \
    && rm -rf /var/lib/apt/lists/ /var/cache/apt/

COPY --from=build /usr/local/lib/python3.7/dist-packages /usr/local/lib/python3.7/dist-packages
COPY --from=build /usr/lib/python3/dist-packages /usr/lib/python3/dist-packages
COPY --from=build /usr/local/bin /usr/local/bin
COPY --from=build /app /app

RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home /app app \
    && mkdir -p /app/shuup_workbench/var/media \
    && chown -R app:app /app/shuup_workbench/var

USER app
WORKDIR /app

ENV DJANGO_DEBUG=0 DJANGO_SERVE_STATIC=1 PYTHONUNBUFFERED=1
EXPOSE 8000

CMD ["gunicorn", "shuup_workbench.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--access-logfile", "-"]
